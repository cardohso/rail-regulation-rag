# Copy to .env and fill in locally. Never commit .env.

# --- LLM providers (both free tiers, no card) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# Which provider answers and which judges (must be different model families)
GENERATOR_PROVIDER=gemini
JUDGE_PROVIDER=groq

# --- Vector store: "azure" or "chroma" ---
VECTOR_STORE=chroma
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=rail-tsi

# --- Langfuse tracing (free Hobby tier) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
