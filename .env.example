# Copy to .env and fill in locally. Never commit .env.

# --- LLM providers (both free tiers, no card) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# Which provider answers and which judges (must be different model families)
GENERATOR_PROVIDER=gemini
JUDGE_PROVIDER=groq
# Optional model overrides (empty = defaults: gemini-3.5-flash-lite, openai/gpt-oss-120b)
GENERATOR_MODEL=
JUDGE_MODEL=

# --- Vector store: "qdrant" (local, in-process) or "azure" ---
VECTOR_STORE=qdrant
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=rail-tsi
# "hybrid" (BM25 + vectors, RRF-fused) or "dense" (vectors only)
SEARCH_MODE=hybrid

# --- Langfuse tracing (free Hobby tier) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Deployment (Hugging Face Spaces): write token, only needed to deploy ---
HF_TOKEN=
