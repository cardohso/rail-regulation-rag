# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local data artefacts (raw downloads and vector indexes are rebuilt by scripts)
data/raw/
data/index/
chroma/

# OS / editors
.DS_Store
.idea/
.vscode/

# Eval caches and scratch outputs (latest.json is committed on purpose)
eval/.cache/
eval/results/*
!eval/results/latest.json
!eval/results/latest.md
!eval/results/retrieval.json
!eval/results/hybrid-local-judge-free.json

# Local tool config
.claude/
!eval/results/dual-judge.json
!eval/results/dual-judge.md
